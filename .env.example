# Firecrawl -- discovery + verification engine (https://firecrawl.dev)
FIRECRAWL_API_KEY=fc-...

# Resend -- outreach sending (optional, only for outreach/)
RESEND_API_KEY=re_...
OUTREACH_FROM="Your Name <you@yourdomain.com>"

# Where Firecrawl responses are cached so re-runs cost nothing
SCAVENGER_CACHE=data/raw/cache
